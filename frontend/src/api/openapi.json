        }
      }
    },
    "/api/games/{match_id}": {
      "get": {
        "summary": "Get Game",
        "operationId": "get_game_api_games__match_id__get",
        "parameters": [
          {
            "name": "match_id",
            "in": "path",
            "required": true,
